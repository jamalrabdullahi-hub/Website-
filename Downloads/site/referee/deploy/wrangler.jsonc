{
  // Development deployment on Buurwen.com. No secrets belong in this file.
  "name": "garsoore-dev",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "buurwen.com", "custom_domain": true },
    { "pattern": "www.buurwen.com", "custom_domain": true },
    { "pattern": "business.buurwen.com", "custom_domain": true }
  ]
}
